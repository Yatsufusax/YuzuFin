<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Sin permisos: la app es local-first y en esta fase no los necesita.
        El permiso de notificaciones (POST_NOTIFICATIONS) se añadirá en la Fase 3,
        cuando existan los recordatorios de cobros y vencimientos.
    -->

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YuzuFin">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.YuzuFin.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
