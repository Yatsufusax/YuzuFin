<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Carpeta donde se guarda la actualización descargada. -->
    <cache-path
        name="updates"
        path="updates/" />
    <!-- Extractos en PDF generados para compartir; se borran al generar uno nuevo. -->
    <cache-path
        name="exports"
        path="exports/" />
    <!-- Foto recién sacada con la cámara, antes de importarla. -->
    <cache-path
        name="capture"
        path="capture/" />
    <!-- Comprobante de movimiento en PDF para compartir. -->
    <cache-path
        name="vouchers"
        path="vouchers/" />
</paths>
