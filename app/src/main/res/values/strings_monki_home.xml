    <string name="monki_story_1_tag">Conocé a Monki</string>
    <string name="monki_story_1_title">¡Hola, soy Monki!</string>
    <string name="monki_story_1_body">Tu compañero de plata. Vivo en tu teléfono y me sé tus números de memoria.</string>
    <string name="monki_story_2_tag">Charla</string>
    <string name="monki_story_2_title">Preguntame lo que quieras</string>
    <string name="monki_story_2_body">“¿Cuánto gasté esta semana?”, “¿en qué se me va la plata?”. Escribilo o decilo con el micrófono.</string>
    <string name="monki_story_3_tag">Cuentas</string>
    <string name="monki_story_3_title">Te hago las cuentas</string>
    <string name="monki_story_3_body">Calculo cómo cerrás el mes, cazo los gastos hormiga y pruebo escenarios: “¿y si gasto un 15 % menos?”.</string>
    <string name="monki_story_4_tag">Privacidad</string>
    <string name="monki_story_4_title">Miro, pero no toco nada</string>
    <string name="monki_story_4_body">Leo tus datos y nada más: no puedo cambiarlos ni mandarlos a ningún lado. Todo queda en este teléfono.</string>
    <string name="monki_story_5_tag">Ojo</string>
    <string name="monki_story_5_title">Una mano, no la última palabra</string>
    <string name="monki_story_5_body">Soy un compañero, no un asesor. Si un número no te cierra, revisalo vos. ¿Arrancamos?</string>
